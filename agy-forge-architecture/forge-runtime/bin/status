#!/bin/bash
# Show task states. Usage: bin/status [id]
FORGE="$(cd "$(dirname "$0")/.." && pwd)"
for t in "$FORGE"/tasks/${1:-*}/; do
  id="$(basename "$t")"
  st="$(jq -c . "$t/status.json" 2>/dev/null || echo '{"state":"todo"}')"
  sum="$(tail -1 "$FORGE/logs/$id/summary.txt" 2>/dev/null)"
  echo "$id  $st  ${sum:+| $sum}"
done
